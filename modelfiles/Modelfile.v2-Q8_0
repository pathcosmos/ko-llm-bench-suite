# FRANKENSTALLM 3B v2 — Q8_0 양자화
# 사용법:
#   1. <PATH_TO_GGUF>를 실제 GGUF 파일 경로로 교체
#   2. ollama create frankenstallm-3b-v2-Q8_0 -f modelfiles/Modelfile.v2-Q8_0

# 학습 형식 (configs/standard/formats.yaml user_assistant_v1, 2026-11-18 검증):
#   "<|user|>\n{질문}\n<|assistant|>\n" — SFT 학습 코드(data/sft_dataset.py)와 같은 문자열을 만든다.
#   system 역할은 학습 데이터에서 무시되었으므로 템플릿에 넣지 않는다 (이전의 SYSTEM 줄은 TEMPLATE {{ .Prompt }}에
#   .System이 없어 원래도 적용되지 않았다).
# 주의: 이 파일의 배포 GGUF는 학습 후 만든 토크나이저를 담고 있어 학습과 토큰이 다르다 (BOS 자동 추가, 개행을 학습되지 않은
#   byte 토큰으로, 분절 알고리즘 차이). 학습과 토큰이 일치하는 실행은 Modelfile.frankenstallm-3b-v2-train-tokenizer를 쓴다.
FROM /home/lanco/models/frankenstallm-v2/gguf/frankenstallm-3b-v2-Q8_0.gguf
TEMPLATE """{{- $hist := "" }}{{- $pend := "" }}{{- range .Messages }}{{- if eq .Role "user" }}{{- if $pend }}{{- $pend = printf "%s\n%s" $pend .Content }}{{- else }}{{- $pend = .Content }}{{- end }}{{- else if eq .Role "assistant" }}{{- if $pend }}{{- $hist = printf "%s<|user|>\n%s\n<|assistant|>\n%s\n" $hist $pend .Content }}{{- $pend = "" }}{{- end }}{{- end }}{{- end }}{{- $hist }}{{- if $pend }}{{ printf "<|user|>\n%s\n<|assistant|>\n" $pend }}{{- end }}"""
PARAMETER num_ctx 4096
PARAMETER num_predict 512
PARAMETER repeat_penalty 1.2
PARAMETER stop </s>
PARAMETER temperature 0.7
PARAMETER top_k 50
PARAMETER top_p 0.9
