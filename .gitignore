# Claude Code
.claude/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# Claude Code (민감한 명령어 기록 포함 가능)
.claude/

# 대용량 결과 (선택적 포함 — 체크포인트는 포함)
# results/ 는 포함시킴 (현재 진행 중인 평가 결과 보존)

# Ollama 모델 (GGUF 파일은 너무 큼)
*.gguf

# 로그
*.log
/tmp/

# 테스트 커버리지
.coverage
htmlcov/

# 스크린샷 출력
screenshot_outputs/
screenshot_outputs_new/

# 표준 벤치 문항별 결과: 데이터셋 원문(일부 gated·비상업 cc-by-nc-nd: KMMLU-Redux/Pro, KoBALT)을 담고 크다(수백 MB).
# 공개 저장소에 재배포하지 않고 로컬(NFS)에만 둔다. 요약 JSON(점수·설정·버전)만 커밋한다.
results/**/*.samples.jsonl.gz
results/**/*.tmp
# 스모크(--limit) 결과
results/**/*__limit*

# 생성 벤치(results/gen): 모델 출력·judge 기록(*.jsonl, 문항 원문 포함)과 문항별 점수(*.score.json)는 로컬(NFS)에만 둔다.
# 커밋은 설정·버전(*.meta.json)과 문항 결과를 뺀 요약(*.summary.json, `gen_report summarize`)만. 수정 전 보존본(_superseded*)도 로컬.
results/gen/**/*.jsonl
results/gen/**/*.score.json
results/gen/_superseded*/
